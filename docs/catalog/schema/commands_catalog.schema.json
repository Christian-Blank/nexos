{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexos.local/catalog/schema/commands_catalog.schema.json",
  "title": "NexOS Commands Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "root", "version", "commands", "schemas"],
  "properties": {
    "schema": {
      "const": "commands_catalog.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 UTC timestamp"
    },
    "root": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "plugin", "args"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "plugin": { "type": "string", "minLength": 1 },
          "about": { "type": ["string", "null"] },
          "usage": { "type": ["string", "null"] },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "required"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "long": { "type": ["string", "null"] },
                "short": { "type": ["string", "null"] },
                "kind": {
                  "type": "string",
                  "enum": ["flag", "value", "multi"]
                },
                "required": { "type": "boolean" },
                "default": { "type": ["string", "null"] },
                "possible_values": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    { "type": "null" }
                  ]
                },
                "help": { "type": ["string", "null"] }
              }
            }
          },
          "toolspec": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["name", "args_schema_ref", "result_schema_ref"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "args_schema_ref": { "type": "string", "minLength": 1 },
              "result_schema_ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "schemas": {
      "type": "object",
      "description": "Map of schema filename to JSON Schema (schemars output)",
      "additionalProperties": {
        "type": ["object", "array", "string", "number", "boolean", "null"]
      }
    }
  }
}
