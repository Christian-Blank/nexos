{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terminal Command Record v0.1",
  "type": "object",
  "required": ["ts", "cmd", "exit_code", "stdout_sha256", "stderr_sha256", "duration_ms"],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 timestamp when the command started (or ended; choose and document consistently)"
    },
    "cmd": {
      "type": "string",
      "description": "Shell command string"
    },
    "exit_code": {
      "type": "integer",
      "description": "Process exit code"
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of stdout content file"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of stderr content file"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall time duration in milliseconds"
    },
    "git_pre_status": {
      "type": "string",
      "description": "git status --porcelain=v2 output before command"
    },
    "git_post_status": {
      "type": "string",
      "description": "git status --porcelain=v2 output after command"
    },
    "patch_path": {
      "type": "string",
      "description": "Relative path to generated patch file (if any)"
    }
  },
  "additionalProperties": true
}
