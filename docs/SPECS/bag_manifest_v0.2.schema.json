{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BagManifestV02",
  "type": "object",
  "required": [
    "chain_ok",
    "counts",
    "created_at",
    "format",
    "version"
  ],
  "properties": {
    "chain_ok": {
      "type": "boolean"
    },
    "commands": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      }
    },
    "counts": {
      "$ref": "#/definitions/BagCounts"
    },
    "created_at": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugins": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      }
    },
    "run_manifest_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "default": "bag_manifest.v0.2",
      "type": "string"
    },
    "time_range": {
      "anyOf": [
        {
          "$ref": "#/definitions/BagTimeRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "topics": {
      "anyOf": [
        {
          "$ref": "#/definitions/BagTopics"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "string"
    }
  },
  "definitions": {
    "BagCounts": {
      "type": "object",
      "required": [
        "cline_tasks",
        "events",
        "files_watch",
        "term_commands"
      ],
      "properties": {
        "cline_tasks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "events": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "files_watch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "term_commands": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "BagTimeRange": {
      "type": "object",
      "required": [
        "end",
        "start"
      ],
      "properties": {
        "end": {
          "type": "string"
        },
        "start": {
          "type": "string"
        }
      }
    },
    "BagTopics": {
      "type": "object",
      "properties": {
        "events": {
          "anyOf": [
            {
              "$ref": "#/definitions/TopicRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "files_watch": {
          "anyOf": [
            {
              "$ref": "#/definitions/TopicRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/definitions/TermTopics"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "TermTopics": {
      "type": "object",
      "properties": {
        "commands": {
          "anyOf": [
            {
              "$ref": "#/definitions/TopicRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TopicRef": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}