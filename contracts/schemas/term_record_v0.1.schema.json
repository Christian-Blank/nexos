{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TermRecordV01",
  "type": "object",
  "required": [
    "args",
    "cmd",
    "dur_ms",
    "exit_code",
    "finished_at",
    "run_id",
    "started_at"
  ],
  "properties": {
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cmd": {
      "type": "string"
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ]
    },
    "dur_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "exit_code": {
      "type": "integer",
      "format": "int32"
    },
    "finished_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "default": "term_record.v0.1",
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "stderr_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "stdout_sha256": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}