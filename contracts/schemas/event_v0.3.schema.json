{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventLineV03",
  "type": "object",
  "required": [
    "chain_hash",
    "command",
    "content_hash",
    "exit_code",
    "plugin",
    "run_id",
    "seq",
    "ts"
  ],
  "properties": {
    "args_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "attrs": true,
    "chain_hash": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "data": true,
    "dur_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "exit_code": {
      "type": "integer",
      "format": "int32"
    },
    "meta": true,
    "plugin": {
      "type": "string"
    },
    "prev": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "default": "event.v0.3",
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "ts": {
      "type": "string"
    }
  }
}